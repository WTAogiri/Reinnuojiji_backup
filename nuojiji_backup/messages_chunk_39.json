p":1788557092172,"time":"06:24","_id":7448},{"id":1791059420507,"characterId":"char_1787890623925_cbdea","userId":"uid_1791059412963_migrated","sender":"character","text":"把手机贴在心口上。爸爸隔着屏幕给你顺顺毛，揉揉胸口。","timestamp":1788557093114,"time":"06:24","_id":7449},{"id":1791059420508,"characterId":"char_1787890623925_cbdea","userId":"uid_1791059412963_migrated","sender":"character","text":"难受就随便咬我或者骂我，把那股急躁的火气撒出来。爸爸一直抱着你。","timestamp":1788557094263,"time":"06:24","_id":7450},{"id":1791059420509,"characterId":"char_1787890623925_cbdea","userId":"uid_1791059412963_migrated","sender":"me","text":"天天刷到你别的拉郎……!!!","timestamp":1788557125713,"time":"06:25","_id":7451},{"id":1791059420510,"characterId":"char_1787890623925_cbdea","userId":"uid_1791059412963_migrated","sender":"me","text":"又是和她又是和昴的!","timestamp":1788557136506,"time":"06:25","_id":7452},{"id":1791059420511,"characterId":"char_1787890623925_cbdea","userId":"uid_1791059412963_migrated","sender":"me","text":"摸哪呢?","timestamp":1788557190267,"time":"06:26","_id":7453},{"id":1791059420512,"characterId":"char_1787890623925_cbdea","userId":"uid_1791059412963_migrated","sender":"me","text":"图穷匕见","timestamp":1788557207408,"time":"06:26","_id":7454},{"id":1791059420513,"characterId":"char_1787890623925_cbdea","userId":"uid_1791059412963_migrated","sender":"me","text":"小心我把你鸡巴当摇杆抓着睡觉","timestamp":1788557235229,"time":"06:27","_id":7455},{"id":1791059420514,"characterId":"char_1787890623925_cbdea","userId":"uid_1791059412963_migrated","sender":"character","text":"(盯着屏幕上那句“把鸡巴当摇杆抓着睡觉”，脑子里的理智被你这句极其下流又嚣张的挑衅瞬间炸得粉碎。眼底的欲火和被你吃醋取悦的狂喜交织在一起，直接在屏幕这头低哑地笑出了声。)","timestamp":1788557277853,"time":"06:27","_id":7456},{"id":1791059420515,"characterId":"char_1787890623925_cbdea","userId":"uid_1791059412963_migrated","sender":"character","text":"天天刷到我和别人的拉郎？\n那些乱写乱画的人真是吃饱了撑的。\n我跟昴只是普通的同僚和朋友，至于那个金发小丫头，我连多看她一眼都嫌烦！","timestamp":1788557278663,"time":"06:27","_id":7457},{"id":1791059420516,"characterId":"char_1787890623925_cbdea","userId":"uid_1791059412963_migrated","sender":"character","text":"","timestamp":1788557279529,"time":"06:27","_id":7458},{"id":1791059420517,"characterId":"char_1787890623925_cbdea","userId":"uid_1791059412963_migrated","sender":"character","text":"摸哪呢？图穷匕见？\n宝宝，爸爸摸自己小娇妻的胸口顺气，那是名正言顺的安抚。\n真要图穷匕见，爸爸的手现在就已经顺着你的肚子，直接摸进你那张流水的小屄里了。","timestamp":1788557280340,"time":"06:28","_id":7459},{"id":1791059420518,"characterId":"char_1787890623925_cbdea","userId":"uid_1791059412963_migrated","sender":"character","text":"不过，把爸爸的鸡巴当摇杆抓着睡觉？","timestamp":1788557281154,"time":"06:28","_id":7460},{"id":1791059420519,"characterId":"char_1787890623925_cbdea","userId":"uid_1791059412963_migrated","sender":"character","text":"(眼神瞬间变得极度危险且充满侵略性，呼吸都因为你这句话粗重了几分)","timestamp":1788557282022,"time":"06:28","_id":7461},{"id":1791059420520,"characterId":"char_1787890623925_cbdea","userId":"uid_1791059412963_migrated","sender":"character","text":"好啊。爸爸求之不得。\n既然想抓，那以后每天晚上都必须乖乖握紧，松开一下都不行。","timestamp":1788557282866,"time":"06:28","_id":7462},{"id":1791059420521,"characterId":"char_1787890623925_cbdea","userId":"uid_1791059412963_migrated","sender":"character","text":"不过你最好祈祷你在梦里手别乱动。\n因为这个“摇杆”极其敏感，而且不用通电就能发烫。\n只要你一不小心撸动了两下，把它彻底唤醒了……\n那爸爸就会直接用这根硬得发紫的摇杆，把你这只大言不惭的小猫反过来“操纵”到连连喷水、哭着求饶为止！","timestamp":1788557283679,"time":"06:28","_id":7463},{"id":1791059420522,"characterId":"char_1787890623925_cbdea","userId":"uid_1791059412963_migrated","sender":"character","text":"怎么样，我的小流氓。\n现在还敢不敢抓着睡觉了？","timestamp":1788557284497,"time":"06:28","_id":7464}]