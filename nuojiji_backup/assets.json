[{"id":"abjn1s","kind":"avatar","name":"","desc":"動漫插圖，身穿白色騎士制服的紅髮青年在歐式石磚巷道中深情親吻一名綠髮女子，神態溫柔繾綣，圖中無文字。","tags":[],"owners":["char:char_1787890623925_cbdea"],"mediaRef":596,"mime":"image/jpeg","duration":0,"createdAt":1791129029071,"updatedAt":1791129082603,"pairMediaRef":599,"wearOn":null},{"id":"ak93jc","kind":"avatar","name":"1040g3k03247963sj0m305ocsvk141fd7cvf5heg!nd dft wlteh jpg 3","desc":"車內一名身穿黑西裝、戴金屬手錶且手背帶有刺青的男子，身前依偎躺著一隻嬌小的虎斑小奶貓，右下角有小紅書圖標，圖中無其他可辨識文字。","tags":[],"owners":["char:char_1787890623925_cbdea"],"mediaRef":597,"mime":"image/jpeg","duration":0,"createdAt":1791129029104,"updatedAt":1791129055111},{"id":"awcnan","kind":"avatar","name":"1040g2sg325jb6nkd4c705qeg0cmcv6lqeu5dm0o!nd dft wlteh jpg 3","desc":"黑白動漫線稿插畫，一名面帶溫柔微笑、雙眼瞇起的少年騎士，雙頰畫有粉色圈圈腮紅，顯得靦腆害羞，圖中無文字。","tags":[],"owners":["char:char_1787890623925_cbdea"],"mediaRef":598,"mime":"image/jpeg","duration":0,"createdAt":1791129029120,"updatedAt":1791129055108},{"id":"p07qgh","kind":"photo","name":"","desc":"","tags":[],"owners":["char:char_1787890623925_cbdea"],"mediaRef":673,"mime":"image/jpeg","duration":0,"createdAt":1791178069634,"updatedAt":1791178069635,"packFrom":{"packId":"mutj4ns6iau0ga","key":"i69"}},{"id":"p0903q","kind":"photo","name":"","desc":"","tags":[],"owners":["char:char_1787890623925_cbdea"],"mediaRef":626,"mime":"image/jpeg","duration":0,"createdAt":1791178069047,"updatedAt":1791178069048,"packFrom":{"packId":"mutj4ns6iau0ga","key":"i22"}},{"id":"p0b2wy","kind":"photo","name":"","desc":"","tags":[],"owners":["char:char_1787890623925_cbdea"],"mediaRef":739,"mime":"image/jpeg","duration":0,"createdAt":1791178099769,"updatedAt":1791178099770,"packFrom":{"packId":"mutjfu6xn4iiku","key":"i35"}},{"id":"p0cnx6","kind":"photo","name":"","desc":"","tags":[],"owners":["char:char_1787890623925_cbdea"],"mediaRef":615,"mime":"image/jpeg","duration":0,"createdAt":1791178068924,"updatedAt":1791178068925,"packFrom":{"packId":"mutj4ns6iau0ga","key":"i11"}},{"id":"p0et9a","kind":"photo","name":"","desc":